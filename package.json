{
  "name": "ipl-player-tracker",
  "version": "0.1.0",
  "description": "Unified cross-tournament performance tracker for IPL players",
  "type": "module",
  "main": "src/cli/index.js",
  "scripts": {
    "setup": "node src/cli/setup.js",
    "track": "node src/cli/index.js",
    "digest": "node src/cli/digest.js",
    "scrape": "node src/ingest-crex.js",
    "fixtures": "node src/ingest-fixtures.js",
    "build": "node src/build-index.js && node src/bundle-site.js",
    "refresh": "npm run scrape && npm run fixtures && npm run build",
    "backfill": "node src/backfill-test-days.js",
    "test": "node --test src/*.test.js src/**/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "playwright": "1.48.0"
  }
}
